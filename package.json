{
  "name": "cadlite",
  "productName": "CADLite",
  "version": "1.0.0",
  "description": "A basic parametric CAD application (parts + assemblies) inspired by SolidWorks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test-measure-engine.js && node test-step-measurement.js && node test-tns.js && node test-feature-tree.js && node test-constraint-solver.js && node test-face-sketch.js && node test-sweep-loft.js",
    "dist": "electron-builder",
    "release": "node scripts/release.js",
    "test:viewer": "node test-step-viewer.js && node test-section-caps.js && node test-exploded-view.js",
    "test:viewer:ui": "electron scripts/test-viewer-ui.cjs"
  },
  "author": "Riyaz",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "three": "^0.165.0"
  },
  "build": {
    "appId": "com.riyaz.cadlite",
    "productName": "CADLite",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "src/**/*",
      "node_modules/**/*",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm"
      }
    ],
    "asarUnpack": [
      "**/*.wasm"
    ]
  }
}
