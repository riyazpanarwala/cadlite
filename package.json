{
  "name": "cadlite",
  "productName": "CADLite",
  "version": "0.1.0",
  "description": "A basic parametric CAD application (parts + assemblies) inspired by SolidWorks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Riyaz",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "opencascade.js": "^2.0.0-beta.b5ff984",
    "three": "^0.165.0"
  },
  "build": {
    "appId": "com.riyaz.cadlite",
    "productName": "CADLite",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/*.wasm"
    ]
  }
}
